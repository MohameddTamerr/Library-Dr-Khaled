<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>

<StackPane fx:id="cashierRootStack" xmlns:fx="http://javafx.com/fxml/1" 
      xmlns="http://javafx.com/javafx/21" 
      fx:controller="com.library.pos.controller.CashierController">

<BorderPane styleClass="cashier-root">

    <!-- TOP: Header Bar -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="8" right="16" bottom="8" left="16"/></padding>
            
            <Label text="%cashier.title" styleClass="header-title"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button fx:id="backButton" text="لوحة التحكم" onAction="#handleBackToDashboard" styleClass="btn-secondary" visible="false"/>
            <Region prefWidth="20"/>

            <Label fx:id="workerNameLabel" styleClass="worker-label"/>
            <Label fx:id="dailyCashLabel" text="0.00 ج.م" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Label fx:id="dailySupplierPaymentsLabel" text="مدفوعات الموردين اليوم: 0.00 ج.م" style="-fx-text-fill: -color-warning; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Label fx:id="dateTimeLabel" styleClass="datetime-label"/>
            
            <Button text="المرتجعات" onAction="#handleReturns" styleClass="btn-returns"/>
            <Button text="تحصيل آجل" onAction="#handleDeferredCollection" styleClass="btn-secondary"/>
            <Button text="دفعات الموردين" onAction="#handleSupplierPayment" styleClass="btn-secondary"/>
            <Button text="%cashier.logout" onAction="#handleLogout" styleClass="btn-danger"/>
        </HBox>
    </top>

    <!-- CENTER: Main Content -->
    <center>
        <VBox spacing="12" styleClass="cashier-body">
            <!-- Top Row: Scan + Quick + Cart Header -->
            <HBox spacing="16" alignment="TOP_LEFT" styleClass="cashier-top-row">
                <VBox styleClass="scanner-panel cashier-left" spacing="12" HBox.hgrow="ALWAYS">
                    <HBox spacing="12" alignment="TOP_LEFT">
                        <VBox styleClass="barcode-section" spacing="10" HBox.hgrow="ALWAYS">
                            <Label text="%cashier.scan" styleClass="section-label"/>
                            <HBox spacing="10">
                                <TextField fx:id="barcodeField" 
                                           promptText="%cashier.scan.placeholder" 
                                           onAction="#handleBarcodeEnter"
                                           styleClass="barcode-input"
                                           HBox.hgrow="ALWAYS"/>
                                <Button text="%cashier.search" onAction="#handleSearch" styleClass="btn-primary"/>
                            </HBox>
                            <ListView fx:id="suggestionList" styleClass="suggestion-list" visible="false" managed="false" prefHeight="150"/>
                        </VBox>

                        <VBox styleClass="quick-section quick-inline" spacing="8">
                            <Label text="%cashier.quick" styleClass="section-label-small"/>
                            <GridPane hgap="8" vgap="8">
                                <Button fx:id="quickBtn1" text="F1" styleClass="quick-btn" onAction="#handleQuickBtn" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                                <Button fx:id="quickBtn2" text="F2" styleClass="quick-btn" onAction="#handleQuickBtn" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                                <Button fx:id="quickBtn3" text="F3" styleClass="quick-btn" onAction="#handleQuickBtn" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                                <Button fx:id="quickBtn4" text="F4" styleClass="quick-btn" onAction="#handleQuickBtn" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                                <Button fx:id="quickBtn5" text="F5" styleClass="quick-btn" onAction="#handleQuickBtn" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                                <Button fx:id="quickBtn6" text="F6" styleClass="quick-btn" onAction="#handleQuickBtn" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            </GridPane>
                        </VBox>
                    </HBox>
                </VBox>

                <HBox styleClass="cart-header cart-header-inline" alignment="CENTER_LEFT" spacing="12">
                    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="%cashier.clear" onAction="#handleClearCart" styleClass="btn-danger-sm"/>
                </HBox>
            </HBox>

            <HBox spacing="12" VBox.vgrow="ALWAYS">
                <!-- Cart Panel -->
                <VBox styleClass="cart-panel cart-full" HBox.hgrow="ALWAYS">
                    <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" styleClass="cart-table">
                        <columns>
                            <TableColumn fx:id="productCol" text="%cashier.col.product" prefWidth="140"/>
                            <TableColumn fx:id="qtyCol" text="%cashier.col.qty" prefWidth="60"/>
                            <TableColumn fx:id="priceCol" text="%cashier.col.price" prefWidth="80"/>
                            <TableColumn fx:id="totalCol" text="%cashier.col.total" prefWidth="80"/>
                            <TableColumn fx:id="actionCol" text="" prefWidth="50"/>
                        </columns>
                        <columnResizePolicy>
                             <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <VBox styleClass="cart-summary" spacing="8">
                        <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="%cashier.items" styleClass="summary-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="itemCountLabel" text="0" styleClass="summary-value"/>
                        </HBox>
                        <Separator/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="%cashier.total" styleClass="total-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="grandTotalLabel" text="0.00" styleClass="total-value"/>
                            <Label text=" ج.م" styleClass="currency-label"/>
                        </HBox>
                        <Label fx:id="deliveryManSummaryLabel" text="" styleClass="field-label" visible="false" managed="false"/>
                    </VBox>

                    <VBox styleClass="payment-method-section" spacing="8">
                        <padding><Insets top="12" right="16" bottom="0" left="16"/></padding>
                        <Label text="طريقة الدفع:" styleClass="section-label-small"/>
                        <ComboBox fx:id="paymentMethodCombo" styleClass="payment-method-combo" maxWidth="Infinity"/>
                    </VBox>

                    <HBox styleClass="payment-buttons" spacing="12">
                        <padding><Insets top="12" right="16" bottom="16" left="16"/></padding>
                        <Button text="تأكيد الدفع (Enter)" onAction="#handlePayment" 
                                styleClass="btn-success-large" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="طباعة تجريبية" onAction="#handlePreviewReceipt" 
                                styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="دفع آجل" onAction="#handleDeferredPayment" 
                                styleClass="btn-warning-large" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                </VBox>

                <!-- Right Panel: Customers & Orders -->
                <VBox styleClass="order-panel" prefWidth="320" minWidth="280" maxWidth="360" VBox.vgrow="ALWAYS">
                    <Label text="%cashier.orders.title" styleClass="section-label"/>

                    <VBox spacing="8">
                        <Label text="%cashier.customer.search" styleClass="section-label-small"/>
                        <HBox spacing="8">
                            <TextField fx:id="customerSearchField" promptText="%cashier.customer.search.prompt" HBox.hgrow="ALWAYS"/>
                            <Button text="عميل جديد" onAction="#handleAddCustomer" styleClass="btn-secondary"/>
                        </HBox>
                        <ListView fx:id="customerSearchList" styleClass="list-view" visible="false" managed="false" prefHeight="140"/>

                        <Label text="%cashier.customer.address" styleClass="section-label-small"/>
                        <Label fx:id="customerAddressLabel" text="-" styleClass="field-label"/>

                        <Label text="%cashier.delivery.man" styleClass="section-label-small"/>
                        <ComboBox fx:id="deliveryManCombo" styleClass="payment-method-combo" maxWidth="Infinity" promptText="%cashier.delivery.none"/>

                        <HBox spacing="8">
                            <Button fx:id="newOrderButton" text="%cashier.order.new" onAction="#handleNewOrder"
                                    styleClass="btn-secondary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button fx:id="saveOrderButton" text="%cashier.order.save" onAction="#handleSaveOrder"
                                    styleClass="btn-primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                        <Button fx:id="deleteOrderButton" text="%cashier.order.delete" onAction="#handleDeleteOrder"
                                styleClass="btn-danger" maxWidth="Infinity"/>
                    </VBox>

                    <Separator/>
                    <Label text="%cashier.orders.open" styleClass="section-label-small"/>
                    <Label text="طلبات التوصيل" styleClass="section-label-small"/>
                    <ListView fx:id="openDeliveryOrdersList" styleClass="list-view" prefHeight="160"/>
                    <Label text="طلبات داخل المحل" styleClass="section-label-small"/>
                    <ListView fx:id="openStoreOrdersList" styleClass="list-view" VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>

</StackPane>
