<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1" 
      xmlns="http://javafx.com/javafx/21" 
      fx:controller="com.library.pos.controller.CashierController"
      styleClass="cashier-root">

    <!-- TOP: Header Bar -->
    <top>
        <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>
            
            <Label text="📚" style="-fx-font-size: 28px;"/>
            <Label text="%cashier.title" styleClass="header-title"/>
            
            <Region HBox.hgrow="ALWAYS"/>
            
            <Button fx:id="backButton" text="🔙 لوحة التحكم" onAction="#handleBackToDashboard" styleClass="btn-secondary" visible="false"/>
            <Region prefWidth="20"/>

            <Label fx:id="workerNameLabel" styleClass="worker-label"/>
            <Label fx:id="dailyCashLabel" text="💰 0.00" style="-fx-text-fill: -color-success; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Label fx:id="dateTimeLabel" styleClass="datetime-label"/>
            
            <Button text="%cashier.logout" onAction="#handleLogout" styleClass="btn-danger"/>
        </HBox>
    </top>

    <!-- CENTER: Main Content -->
    <center>
        <HBox spacing="0" HBox.hgrow="ALWAYS">
            
            <!-- LEFT PANEL: Scanner & Product -->
            <VBox styleClass="scanner-panel" spacing="20" HBox.hgrow="ALWAYS">
                <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
                
                <!-- Barcode Scanner Input -->
                <VBox styleClass="barcode-section" spacing="10">
                    <Label text="%cashier.scan" styleClass="section-label"/>
                    <HBox spacing="10">
                        <TextField fx:id="barcodeField" 
                                   promptText="%cashier.scan.placeholder" 
                                   onAction="#handleBarcodeEnter"
                                   styleClass="barcode-input"
                                   HBox.hgrow="ALWAYS"/>
                        <Button text="%cashier.search" onAction="#handleSearch" styleClass="btn-primary"/>
                    </HBox>
                </VBox>
                
                <!-- Product Display Card -->
                <VBox fx:id="productCard" styleClass="product-card" spacing="16" VBox.vgrow="ALWAYS">
                    <Label fx:id="productNameLabel" text="-" styleClass="product-name" wrapText="true"/>
                    
                    <HBox alignment="CENTER_LEFT" spacing="20">
                        <VBox spacing="4">
                            <Label text="%cashier.price" styleClass="label-muted"/>
                            <Label fx:id="priceLabel" text="0.00" styleClass="product-price"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="%cashier.stock" styleClass="label-muted"/>
                            <Label fx:id="stockLabel" text="-" styleClass="product-stock"/>
                        </VBox>
                        <VBox spacing="4">
                            <Label text="%cashier.barcode" styleClass="label-muted"/>
                            <Label fx:id="barcodeDisplayLabel" text="-" styleClass="barcode-display"/>
                        </VBox>
                    </HBox>
                    
                    <Region VBox.vgrow="ALWAYS"/>
                    
                    <!-- Quantity Controls -->
                    <HBox alignment="CENTER" spacing="16" styleClass="qty-section">
                        <Label text="%cashier.qty" styleClass="qty-label"/>
                        <Button fx:id="qtyMinusBtn" text="−" onAction="#handleQtyMinus" styleClass="qty-btn"/>
                        <TextField fx:id="qtyField" text="1" styleClass="qty-input" alignment="CENTER"/>
                        <Button fx:id="qtyPlusBtn" text="+" onAction="#handleQtyPlus" styleClass="qty-btn"/>
                    </HBox>
                    
                    <Button fx:id="addButton" text="%cashier.add" onAction="#handleAddToCart" 
                            styleClass="btn-add" maxWidth="Infinity" disable="true"/>
                </VBox>
                
                <!-- Quick Access Buttons -->
                <VBox styleClass="quick-section" spacing="8">
                    <Label text="%cashier.quick" styleClass="section-label-small"/>
                    <HBox spacing="8">
                        <Button fx:id="quickBtn1" text="F1" styleClass="quick-btn" onAction="#handleQuickBtn"/>
                        <Button fx:id="quickBtn2" text="F2" styleClass="quick-btn" onAction="#handleQuickBtn"/>
                        <Button fx:id="quickBtn3" text="F3" styleClass="quick-btn" onAction="#handleQuickBtn"/>
                        <Button fx:id="quickBtn4" text="F4" styleClass="quick-btn" onAction="#handleQuickBtn"/>
                        <Button fx:id="quickBtn5" text="F5" styleClass="quick-btn" onAction="#handleQuickBtn"/>
                        <Button fx:id="quickBtn6" text="F6" styleClass="quick-btn" onAction="#handleQuickBtn"/>
                    </HBox>
                </VBox>
            </VBox>
            
            <!-- RIGHT PANEL: Cart -->
            <VBox styleClass="cart-panel" prefWidth="420" minWidth="380">
                
                <!-- Cart Header -->
                <HBox styleClass="cart-header" alignment="CENTER_LEFT" spacing="12">
                    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                    <Label text="%cashier.cart" styleClass="cart-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="%cashier.clear" onAction="#handleClearCart" styleClass="btn-danger-sm"/>
                </HBox>
                
                <!-- Cart Table -->
                <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" styleClass="cart-table">
                    <columns>
                        <TableColumn fx:id="productCol" text="%cashier.col.product" prefWidth="140"/>
                        <TableColumn fx:id="qtyCol" text="%cashier.col.qty" prefWidth="60"/>
                        <TableColumn fx:id="priceCol" text="%cashier.col.price" prefWidth="80"/>
                        <TableColumn fx:id="totalCol" text="%cashier.col.total" prefWidth="80"/>
                        <TableColumn fx:id="actionCol" text="" prefWidth="50"/>
                    </columns>
                    <columnResizePolicy>
                         <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                </TableView>
                
                <!-- Cart Summary -->
                <VBox styleClass="cart-summary" spacing="8">
                    <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
                    
                    <HBox alignment="CENTER_LEFT">
                        <Label text="%cashier.items" styleClass="summary-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="itemCountLabel" text="0" styleClass="summary-value"/>
                    </HBox>
                    
                    <Separator/>
                    
                    <HBox alignment="CENTER_LEFT">
                        <Label text="%cashier.total" styleClass="total-label"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="grandTotalLabel" text="0.00" styleClass="total-value"/>
                        <Label text=" ج.م" styleClass="currency-label"/>
                    </HBox>
                </VBox>
                
                <!-- Payment Method Selection -->
                <VBox styleClass="payment-method-section" spacing="8">
                    <padding><Insets top="12" right="16" bottom="0" left="16"/></padding>
                    <Label text="طريقة الدفع:" styleClass="section-label-small"/>
                    <ComboBox fx:id="paymentMethodCombo" styleClass="payment-method-combo" maxWidth="Infinity"/>
                </VBox>
                
                <!-- Payment Buttons -->
                <HBox styleClass="payment-buttons" spacing="12">
                    <padding><Insets top="12" right="16" bottom="16" left="16"/></padding>
                    <Button text="✓ تأكيد الدفع" onAction="#handlePayment" 
                            styleClass="btn-success-large" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Button text="📋 دفع آجل" onAction="#handleDeferredPayment" 
                            styleClass="btn-warning-large" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
