<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.library.pos.controller.SalesReportController"
      spacing="20" style="-fx-padding: 15;">

    <HBox alignment="CENTER_LEFT" spacing="12">
        <Label text="تقرير مبيعات المنتجات" styleClass="h1"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="إجمالي الكمية المباعة:" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
        <Label fx:id="totalSoldLabel" text="0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
        <Label text="عدد المنتجات:" style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>
        <Label fx:id="uniqueProductsLabel" text="0" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
    </HBox>

    <HBox spacing="12" alignment="CENTER_LEFT"
          style="-fx-background-color: white; -fx-padding: 12; -fx-background-radius: 6;
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 4, 0, 0, 1);">
        <Label text="من:" style="-fx-font-size: 12px;"/>
        <DatePicker fx:id="fromDatePicker" promptText="من" prefWidth="130"/>
        <Label text="إلى:" style="-fx-font-size: 12px;"/>
        <DatePicker fx:id="toDatePicker" promptText="إلى" prefWidth="130"/>
        <TextField fx:id="searchField" promptText="ابحث عن منتج محدد..." prefWidth="260" onKeyReleased="#handleSearch"/>
        <Button text="تصفية" onAction="#handleFilter" styleClass="btn-primary"/>
        <Button text="الكل" onAction="#handleShowAll" styleClass="btn-secondary"/>
    </HBox>

    <TableView fx:id="salesTable" VBox.vgrow="ALWAYS"
               style="-fx-background-radius: 6; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 4, 0, 0, 1);">
        <columns>
            <TableColumn fx:id="productNameCol" text="اسم المنتج" prefWidth="260"/>
            <TableColumn fx:id="soldQtyCol" text="الكمية المباعة" prefWidth="140"/>
            <TableColumn fx:id="txCountCol" text="عدد العمليات" prefWidth="140"/>
            <TableColumn fx:id="totalAmountCol" text="إجمالي المبيعات" prefWidth="180"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
