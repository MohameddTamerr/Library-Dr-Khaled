<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0f172a; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.pos.controller.ChangePasswordController">
    
    <Label text="تغيير كلمة المرور" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    
    <Label text="يجب تغيير كلمة المرور الافتراضية للمتابعة" style="-fx-font-size: 14px; -fx-text-fill: #94a3b8;"/>

    <VBox spacing="10">
        <Label text="اسم المستخدم الجديد" style="-fx-text-fill: #cbd5e1;"/>
        <TextField fx:id="usernameField" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-padding: 10;"/>
    </VBox>

    <VBox spacing="10">
        <Label text="كلمة المرور الجديدة" style="-fx-text-fill: #cbd5e1;"/>
        <PasswordField fx:id="newPasswordField" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-padding: 10;"/>
    </VBox>

    <VBox spacing="10">
        <Label text="تأكيد كلمة المرور" style="-fx-text-fill: #cbd5e1;"/>
        <PasswordField fx:id="confirmPasswordField" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #475569; -fx-border-radius: 5; -fx-padding: 10;"/>
    </VBox>

    <Label fx:id="errorLabel" text="" style="-fx-text-fill: #ef4444;" visible="false"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="حفظ ومتابعة" onAction="#handleSave" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
        <Button text="إلغاء" onAction="#handleCancel" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 20; -fx-cursor: hand;"/>
    </HBox>

</VBox>
