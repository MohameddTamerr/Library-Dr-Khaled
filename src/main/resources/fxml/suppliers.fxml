<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.StackPane?>

<StackPane xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/21"
      fx:controller="com.library.pos.controller.SuppliersController">

<VBox spacing="20" style="-fx-padding: 10;">

    <Label text="إدارة الموردين" styleClass="h1"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="إضافة مورد" onAction="#handleAddSupplier" styleClass="button-primary"/>
        <Button text="تعديل مورد" onAction="#handleEditSupplier" styleClass="button-warning-large"/>
        <Button text="تفعيل / تعطيل" onAction="#handleToggleStatus" styleClass="button-sidebar"/>
        <Button text="عرض المشتريات" onAction="#handleViewPurchases" styleClass="button-sidebar"/>
        <Button text="تسجيل دفعة" onAction="#handleRecordPayment" styleClass="button-action"/>
        <Button text="دمج المكرر" onAction="#handleMergeDuplicates" styleClass="button-danger"/>
        <Button text="تحديث" onAction="#handleRefresh" styleClass="button-sidebar"/>
    </HBox>

    <VBox spacing="15" styleClass="card">
        <Label text="بيانات المورد" styleClass="panel-title"/>

        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="10"/>
            </columnConstraints>

            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label text="اسم المورد"/>
                <TextField fx:id="nameField" promptText="اسم المورد"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label text="رقم الهاتف"/>
                <TextField fx:id="phoneField" promptText="01xxxxxxxxx"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="2" GridPane.rowIndex="0">
                <Label text="البريد الإلكتروني"/>
                <TextField fx:id="emailField" promptText="supplier@email.com"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label text="إجمالي المطلوب"/>
                <TextField fx:id="totalPurchasesField" promptText="إجمالي المبلغ المطلوب"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1" GridPane.columnSpan="2">
                <Label text="العنوان"/>
                <TextField fx:id="addressField" promptText="العنوان بالكامل"/>
            </VBox>

            <VBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="0" GridPane.rowSpan="2">
                <Label text="الحالة"/>
                <CheckBox fx:id="statusCheckBox" text="نشط" selected="true"/>
            </VBox>
        </GridPane>

        <HBox spacing="24" alignment="CENTER_LEFT">
            <VBox spacing="4">
                <Label text="إجمالي المشتريات"/>
                <Label fx:id="totalPurchasesLabel" text="0.00" styleClass="field-label"/>
            </VBox>
            <VBox spacing="4">
                <Label text="إجمالي المدفوع"/>
                <Label fx:id="totalPaidLabel" text="0.00" styleClass="field-label"/>
            </VBox>
            <VBox spacing="4">
                <Label text="المتبقي للدفع"/>
                <Label fx:id="balanceDueLabel" text="0.00" styleClass="field-label"/>
            </VBox>
        </HBox>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="بحث بالاسم أو الهاتف..." prefWidth="300" onAction="#handleSearch"/>
        <Button text="بحث" onAction="#handleSearch" styleClass="button-primary"/>
        <Button text="عرض الكل" onAction="#loadData" styleClass="button-sidebar" style="-fx-text-fill: -text-primary; -fx-background-color: -bg-panel;"/>
    </HBox>

    <TableView fx:id="suppliersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="nameCol" text="الاسم" prefWidth="200"/>
            <TableColumn fx:id="phoneCol" text="الهاتف" prefWidth="140"/>
            <TableColumn fx:id="totalPurchasesCol" text="إجمالي المشتريات" prefWidth="140"/>
            <TableColumn fx:id="totalPaidCol" text="إجمالي المدفوع" prefWidth="140"/>
            <TableColumn fx:id="balanceDueCol" text="الرصيد المستحق" prefWidth="140"/>
            <TableColumn fx:id="statusCol" text="الحالة" prefWidth="90"/>
            <TableColumn fx:id="createdAtCol" text="تاريخ الإنشاء" prefWidth="160"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <Label text="دفعات المورد" styleClass="panel-title"/>
    <TableView fx:id="paymentsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="paymentAmountCol" text="المبلغ" prefWidth="120"/>
            <TableColumn fx:id="paymentMethodCol" text="طريقة الدفع" prefWidth="140"/>
            <TableColumn fx:id="paymentDateCol" text="التاريخ" prefWidth="160"/>
            <TableColumn fx:id="paymentNotesCol" text="ملاحظات" prefWidth="220"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>

    <!-- Payment form overlay -->
    <VBox fx:id="paymentOverlay" visible="false" managed="false"
          alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.5);"
          StackPane.alignment="CENTER">
        <VBox alignment="CENTER" spacing="12"
              style="-fx-background-color: #0f172a; -fx-padding: 30; -fx-border-color: #3b82f6; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;"
              maxWidth="450">
            <HBox alignment="CENTER_RIGHT">
                <Label text="تسجيل دفعة للمورد" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#handleClosePayment" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-font-size: 18px; -fx-cursor: hand;"/>
            </HBox>
            <Label text="المورد" style="-fx-text-fill: #cbd5e1;"/>
            <ComboBox fx:id="paymentSupplierCombo" promptText="اختر المورد" maxWidth="1.7976931348623157E308"/>
            <Label text="المبلغ" style="-fx-text-fill: #cbd5e1;"/>
            <TextField fx:id="paymentAmountField" promptText="المبلغ"/>
            <Label text="طريقة الدفع" style="-fx-text-fill: #cbd5e1;"/>
            <ComboBox fx:id="paymentMethodCombo" maxWidth="1.7976931348623157E308"/>
            <Label text="ملاحظات" style="-fx-text-fill: #cbd5e1;"/>
            <TextArea fx:id="paymentNotesField" promptText="ملاحظات" prefRowCount="2"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="إلغاء" onAction="#handleClosePayment" style="-fx-background-color: #475569; -fx-text-fill: white; -fx-padding: 8 20; -fx-cursor: hand;"/>
                <Button text="تسجيل" onAction="#handleSavePayment" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-padding: 8 20; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>

    <!-- Success overlay -->
    <VBox fx:id="successOverlay" visible="false" managed="false"
          alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.5);"
          StackPane.alignment="CENTER">
        <VBox alignment="CENTER" spacing="16"
              style="-fx-background-color: #0f172a; -fx-padding: 40; -fx-border-color: #10b981; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;"
              maxWidth="400" maxHeight="250">
            <Label text="✓" style="-fx-font-size: 48px; -fx-text-fill: #10b981;"/>
            <Label fx:id="successMessageLabel" text="" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Label fx:id="successDetailsLabel" text="" style="-fx-font-size: 14px; -fx-text-fill: #cbd5e1; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Button text="موافق" onAction="#handleCloseSuccess" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 30; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        </VBox>
    </VBox>

    <!-- Error overlay -->
    <VBox fx:id="errorOverlay" visible="false" managed="false"
          alignment="CENTER" style="-fx-background-color: rgba(0,0,0,0.5);"
          StackPane.alignment="CENTER">
        <VBox alignment="CENTER" spacing="16"
              style="-fx-background-color: #0f172a; -fx-padding: 40; -fx-border-color: #ef4444; -fx-border-width: 2; -fx-border-radius: 12; -fx-background-radius: 12;"
              maxWidth="400" maxHeight="200">
            <Label text="⚠" style="-fx-font-size: 36px; -fx-text-fill: #ef4444;"/>
            <Label fx:id="errorMessageLabel" text="" style="-fx-font-size: 16px; -fx-text-fill: white; -fx-wrap-text: true; -fx-text-alignment: center;"/>
            <Button text="موافق" onAction="#handleCloseError" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-padding: 10 30; -fx-cursor: hand; -fx-font-weight: bold;"/>
        </VBox>
    </VBox>

</StackPane>
