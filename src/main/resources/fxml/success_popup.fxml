<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0f172a; -fx-padding: 30; -fx-border-color: #10b981; -fx-border-width: 2;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.pos.controller.SuccessPopupController">
    
    <Label text="✓" style="-fx-font-size: 48px; -fx-text-fill: #10b981;"/>
    
    <Label fx:id="messageLabel" text="تمت العملية بنجاح" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white; -fx-wrap-text: true; -fx-text-alignment: center;"/>
    
    <Label fx:id="detailsLabel" text="" style="-fx-font-size: 16px; -fx-text-fill: #cbd5e1; -fx-wrap-text: true; -fx-text-alignment: center;"/>

    <Button text="موافق" onAction="#handleClose" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-padding: 10 30; -fx-cursor: hand; -fx-font-weight: bold; -fx-font-size: 14px;"/>

</VBox>
