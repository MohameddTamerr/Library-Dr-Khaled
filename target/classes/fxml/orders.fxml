<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" 
      xmlns="http://javafx.com/javafx/21" 
      fx:controller="com.library.pos.controller.OrdersController"
      spacing="20" style="-fx-padding: 30;">

    <Label text="📜 سجل الاوردرات" styleClass="h1"/>

    <!-- Filter Bar -->
    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
        <Label text="من:"/>
        <DatePicker fx:id="fromDatePicker"/>
        <Label text="إلى:"/>
        <DatePicker fx:id="toDatePicker"/>
        <Button text="تصفية" onAction="#handleFilter" styleClass="button-primary"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="عرض الكل" onAction="#loadAll" styleClass="button-sidebar" style="-fx-text-fill: -text-primary; -fx-background-color: -bg-panel;"/>
    </HBox>

    <!-- Orders Table -->
    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="idCol" text="#" prefWidth="60"/>
            <TableColumn fx:id="dateCol" text="التاريخ" prefWidth="150"/>
            <TableColumn fx:id="customerCol" text="العميل" prefWidth="150"/>
            <TableColumn fx:id="workerCol" text="الموظف" prefWidth="150"/>
            <TableColumn fx:id="amountCol" text="الإجمالي" prefWidth="100"/>
            <TableColumn fx:id="statusCol" text="الحالة" prefWidth="100"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
