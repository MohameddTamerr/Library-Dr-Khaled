<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" 
      xmlns="http://javafx.com/javafx/21" 
      fx:controller="com.library.pos.controller.CustomersController"
      spacing="20" style="-fx-padding: 10;">

    <Label text="👥 إدارة العملاء" styleClass="h1"/>

    <!-- Add/Edit Form -->
    <VBox spacing="15" styleClass="card">
        <Label text="إضافة / تعديل عميل" styleClass="panel-title"/>
        
        <GridPane hgap="15" vgap="15">
             <columnConstraints>
                 <ColumnConstraints percentWidth="40"/>
                 <ColumnConstraints percentWidth="40"/>
                 <ColumnConstraints percentWidth="20"/>
             </columnConstraints>

             <VBox spacing="5" GridPane.columnIndex="0">
                 <Label text="اسم العميل"/>
                 <TextField fx:id="nameField" promptText="الاسم بالكامل"/>
             </VBox>

             <VBox spacing="5" GridPane.columnIndex="1">
                 <Label text="رقم الهاتف"/>
                 <TextField fx:id="phoneField" promptText="01xxxxxxxxx"/>
             </VBox>

             <Button fx:id="mainActionBtn" text="حفظ البيانات" onAction="#handleSave" styleClass="button-action" maxWidth="Infinity" GridPane.columnIndex="2" alignment="BOTTOM_CENTER"/>
        </GridPane>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="بحث باسم العميل أو الهاتف..." prefWidth="300" onAction="#handleSearch"/>
        <Button text="بحث" onAction="#handleSearch" styleClass="button-primary"/>
        <Button text="عرض الكل" onAction="#loadData" styleClass="button-sidebar" style="-fx-text-fill: -text-primary; -fx-background-color: -bg-panel;"/>
    </HBox>

    <!-- Customers Table -->
    <TableView fx:id="customersTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="idCol" text="#" prefWidth="50"/>
            <TableColumn fx:id="nameCol" text="الاسم" prefWidth="250"/>
            <TableColumn fx:id="phoneCol" text="الهاتف" prefWidth="150"/>
            <!-- Action Column added functionally -->
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

</VBox>
