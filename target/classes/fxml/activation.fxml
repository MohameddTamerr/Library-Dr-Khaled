<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0f172a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.library.pos.controller.ActivationController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Product Activation" textFill="WHITE">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    
    <Label text="This copy of the software is not activated." textFill="#94a3b8" />
    <Label text="Please send the Machine ID below to the administrator to receive your license key." textFill="#94a3b8" wrapText="true" textAlignment="CENTER"/>

    <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="400">
        <Label text="Your Machine ID:" textFill="#cbd5e1" />
        <TextField fx:id="machineIdField" style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-padding: 10;" />
        <Button fx:id="copyButton" text="Copy ID" onAction="#handleCopy" style="-fx-background-color: #334155; -fx-text-fill: white; -fx-cursor: hand;" maxWidth="Infinity"/>
    </VBox>

    <VBox spacing="5" alignment="CENTER_LEFT" maxWidth="400">
        <Label text="Enter License Key:" textFill="#cbd5e1" />
        <TextField fx:id="licenseKeyField" promptText="Paste key here..." style="-fx-background-color: #1e293b; -fx-text-fill: white; -fx-border-color: #334155; -fx-padding: 10;" />
    </VBox>

    <Button fx:id="activateButton" text="Activate Product" onAction="#handleActivate" defaultButton="true" 
            style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-size: 14px;" />

</VBox>
